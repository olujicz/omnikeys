// Local builds are signed ad hoc ("Sign to Run Locally").
// For Developer ID builds create Config/Signing.local.xcconfig (gitignored) containing:
//   CODE_SIGN_IDENTITY = Developer ID Application
//   DEVELOPMENT_TEAM = <your team id>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
